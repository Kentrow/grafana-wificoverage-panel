{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "panel",
  "name": "Wi-Fi coverage",
  "id": "kentrow-wificoverage-panel",
  "info": {
    "keywords": ["panel", "wifi", "wireless", "coverage", "heatmap", "floor plan", "rssi"],
    "description": "Predicted Wi-Fi coverage of each access point on a floor plan, band by band, with wall losses.",
    "author": {
      "name": "Kentrow",
      "url": "https://github.com/Kentrow"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      { "name": "Source code", "url": "https://github.com/Kentrow/grafana-wificoverage-panel" },
      { "name": "Report a bug", "url": "https://github.com/Kentrow/grafana-wificoverage-panel/issues" }
    ],
    "screenshots": [
      {
        "name": "Predicted coverage on a floor with walls",
        "path": "img/screenshot-coverage.png"
      },
      {
        "name": "Best AP view of a warehouse",
        "path": "img/screenshot-best-ap.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=13.2.0",
    "plugins": []
  }
}
